generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  NORMAL_USER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum Gender {
  MEN
  WOMEN
  ENFANT
}

model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  password             String
  phoneNumber          String?
  address              String?
  role                 Role      @default(NORMAL_USER)
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  isDeleted            Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  orders             Order[]
  contactSubmissions ContactSubmission[]
  addresses          Address[]

  @@index([role])
  @@index([email])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address   String
  city      String
  phone     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  gender      Gender   @default(MEN)
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  // ── SEO overrides — fall back to auto-generated values from category data when empty ──
  seoTitle       String?
  seoDescription String? @db.Text
  seoKeywords    String?
  ogImage        String?

  products Product[]

  @@index([slug])
  @@index([isActive])
  @@index([parentId])
  @@index([gender])
}

model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  basePrice   Decimal @db.Decimal(10, 3)
  isPublished Boolean @default(false)
  isFeatured  Boolean @default(false)

  // ── Promotion / sale ──────────────────────────────────────────────────────
  promoActive   Boolean   @default(false)
  promoPrice    Decimal?  @db.Decimal(10, 3)
  promoLabel    String?
  promoImage    String?
  promoStartsAt DateTime?
  promoEndsAt   DateTime?
  gender        Gender    @default(MEN)
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // ── SEO overrides — fall back to auto-generated values from product data when empty ──
  seoTitle       String?
  seoDescription String? @db.Text
  seoKeywords    String?
  ogImage        String?

  images     ProductImage[]
  colors     ProductColor[]
  orderItems OrderItem[]

  @@index([slug])
  @@index([isPublished])
  @@index([isFeatured])
  @@index([categoryId])
  @@index([gender])
}

model ProductImage {
  id    String  @id @default(cuid())
  url   String
  alt   String?
  order Int     @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductColor {
  id        String   @id @default(cuid())
  name      String
  hex       String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  images ProductColorImage[]
  sizes  ProductColorSize[]

  @@index([productId])
  @@index([isActive])
}

model ProductColorImage {
  id    String  @id @default(cuid())
  url   String
  alt   String?
  order Int     @default(0)

  colorId String
  color   ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@index([colorId])
}

model ProductColorSize {
  id            String   @id @default(cuid())
  size          String
  stock         Int      @default(0)
  priceOverride Decimal? @db.Decimal(10, 3)

  colorId String
  color   ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)

  orderItems OrderItem[]

  @@unique([colorId, size])
  @@index([colorId])
  @@index([size])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  status      OrderStatus @default(PENDING)

  customerName  String
  customerPhone String
  customerEmail String?
  address       String
  city          String?

  subtotal     Decimal @db.Decimal(10, 3)
  shippingCost Decimal @default(0) @db.Decimal(10, 3)
  total        Decimal @db.Decimal(10, 3)

  discountType   DiscountType?
  discountValue  Decimal?      @db.Decimal(10, 3)
  discountAmount Decimal       @default(0) @db.Decimal(10, 3)

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  items OrderItem[]

  @@index([status])
  @@index([userId])
  @@index([orderNumber])
  @@index([createdAt])
}

model OrderItem {
  id         String  @id @default(cuid())
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 3)
  totalPrice Decimal @db.Decimal(10, 3)

  productName  String
  colorName    String
  size         String
  productImage String?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  variantId String
  variant   ProductColorSize @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model StoreSettings {
  id String @id @default(cuid())

  logoUrl String?

  heroImage String?
  heroCta1  String? @default("Explore")

  videoUrl String?

  shopCoverImage  String?
  menCoverImage   String?
  womenCoverImage String?

  featuredImage             String?
  featuredOverlayLabel      String? @default("Collection")
  featuredOverlayYear       String? @default("2025")
  featuredOverlayCollection String? @default("")

  editorialLabel1 String? @default("Craftsmanship")
  editorialTitle1 String? @default("Made to last")
  editorialDesc1  String? @default("Every pair is built from carefully selected materials, finished by hand for comfort and durability that holds up season after season.") @db.Text
  editorialImage1 String?

  editorialLabel2 String? @default("Design")
  editorialTitle2 String? @default("Timeless silhouettes")
  editorialDesc2  String? @default("Clean lines and considered proportions, designed to move seamlessly between everyday wear and dressed-up occasions.") @db.Text
  editorialImage2 String?

  collectionLabel String? @default("Collection")
  collectionTitle String? @default("Featured Shoes")
  collectionDesc  String? @default("Hand-picked pairs from our collection") @db.Text

  footerCtaTitle String? @default("Find your perfect pair.")
  footerCtaDesc  String? @default("Browse our full catalog of comfort shoes for every occasion.") @db.Text
  footerCtaBtn   String? @default("Shop All Shoes")

  colorAccent      String? @default("#4a7018")
  colorGreenDark   String? @default("#1a3406")
  colorGreen       String? @default("#4a7018")
  colorGreenMid    String? @default("#5c8c1e")
  colorGreenLight  String? @default("#7ab820")
  colorGreenBright String? @default("#9ed43a")

  deliveryFee Decimal @default(0) @db.Decimal(10, 3)

  contactEmail        String? @default("contact@flexshoes.tn")
  contactPhone        String? @default("+216 XX XXX XXX")
  contactLocation     String? @default("Tunisia")
  contactResponseTime String? @default("Within 24 hours")
  contactCoverImage   String?
  promoBadgeImage     String?

  // ── SEO & Référencement ──────────────────────────────────────────────────
  orgName               String? @default("Mia Scarpa")
  seoTitle              String? @default("Mia Scarpa — Chaussures en cuir pour homme et femme en Tunisie")
  seoDescription        String? @default("Découvrez Mia Scarpa : chaussures en cuir pour homme et femme, alliant artisanat, élégance intemporelle et confort au quotidien. Livraison rapide partout en Tunisie.") @db.Text
  seoKeywords           String? @default("mia scarpa, chaussures cuir tunisie, chaussures homme tunisie, chaussures femme tunisie, souliers en cuir, bottines cuir, mocassins, sneakers cuir, chaussures élégantes tunisie")
  seoCanonicalUrl       String?
  seoOgTitle            String?
  seoOgDescription      String? @db.Text
  seoOgImage            String?
  seoTwitterTitle       String?
  seoTwitterDescription String? @db.Text
  seoTwitterImage       String?
  seoIndexingEnabled    Boolean @default(true)

  homepageFeaturedProductIds String[] @default([])

  updatedAt DateTime @updatedAt

  usps StoreUsp[]
}

model StoreUsp {
  id    String @id @default(cuid())
  label String
  desc  String
  order Int    @default(0)

  storeId String
  store   StoreSettings @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([isRead])
  @@index([createdAt])
}

enum SocialPlatform {
  MESSENGER
  INSTAGRAM
  WHATSAPP
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model SocialConversation {
  id              String          @id @default(cuid())
  platform        SocialPlatform
  externalId      String
  customerName    String?
  customerAvatar  String?
  lastMessageText String?
  lastMessageAt   DateTime        @default(now())
  unreadCount     Int             @default(0)
  messages        SocialMessage[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([platform, externalId])
  @@index([platform, lastMessageAt])
}

model SocialMessage {
  id             String             @id @default(cuid())
  conversationId String
  conversation   SocialConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  externalId     String?
  direction      MessageDirection
  text           String?            @db.Text
  attachmentUrl  String?
  sentAt         DateTime           @default(now())

  @@index([conversationId, sentAt])
}
